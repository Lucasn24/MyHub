GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In Google Cloud Console, add BOTH this and your prod callback URL
# (https://<your-domain>/api/google/callback) as authorized redirect URIs on
# the same OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Which calendar the Tasks page syncs/pushes events to. Defaults to your main
# ("primary") calendar if unset. To use a different one: Google Calendar ->
# hover the calendar under "My calendars" -> ⋮ -> Settings and sharing ->
# "Integrate calendar" -> copy the Calendar ID (looks like an email address,
# or "primary" for your main calendar). Restart the dev server after changing.
GOOGLE_CALENDAR_ID=

# Claude (backend) — key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-haiku-4-5
ANTHROPIC_MODEL=

# Supabase — Project Settings > API in your Supabase dashboard. Needed by both
# the Next.js server (lib/supabase.ts, for Google token storage) and the
# Python backend. SERVICE_ROLE key bypasses row-level security — keep it
# server-side only, never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Python FastAPI backend (see myhub/backend) — defaults to the local dev port
# if unset. In production (Railway), point this at the backend service's
# private domain (<service-name>.railway.internal:<port>), not a public URL --
# see backend/README.md's Deploy section.
PYTHON_API_URL=http://localhost:8000
# Shared secret the Next.js server sends as X-Internal-Api-Key on every
# request to the FastAPI backend, and that the backend requires (see
# backend/app/security.py). Must be identical in both apps' env config.
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=
# How often the background inbox sync poller runs, in milliseconds. Defaults to 5 minutes if unset.
EMAIL_SYNC_INTERVAL_MS=

# App login (single shared password -- this is a single-user app, gated by
# proxy.ts + lib/auth). SESSION_SECRET signs the session cookie; generate with:
# openssl rand -base64 32
SESSION_SECRET=
# bcrypt hash of your login password, NOT the plaintext password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
AUTH_PASSWORD_HASH=
