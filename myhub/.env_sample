GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Gemini (backend) — free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional override, defaults to gemini-2.5-flash
GEMINI_MODEL=

# Supabase (backend) — Project Settings > API in your Supabase dashboard.
# SERVICE_ROLE key bypasses row-level security — keep it backend-only, never expose to the frontend/browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Python FastAPI backend (see myhub/backend) — defaults to the local dev port if unset.
PYTHON_API_URL=http://localhost:8000
# How often the background inbox sync poller runs, in milliseconds. Defaults to 5 minutes if unset.
EMAIL_SYNC_INTERVAL_MS=
